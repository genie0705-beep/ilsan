rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 = 이메일/비밀번호로 로그인한 계정
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // 계약서 형식 검증 — 형식이 맞지 않는 쓰레기 데이터 차단
    function validContract(d) {
      return d.deviceUid == request.auth.uid
        && d.deceasedName is string && d.deceasedName.size() > 0 && d.deceasedName.size() <= 40
        && d.chiefName    is string && d.chiefName.size()    > 0 && d.chiefName.size()    <= 40
        && d.receiptDate  is string && d.receiptDate.size() <= 10
        && d.balance      is number
        && d.payload      is map
        && d.payload._sigChief is string && d.payload._sigChief.size() > 0
        && d.payload._sigStaff is string && d.payload._sigStaff.size() > 0;
    }

    match /contracts/{id} {
      allow create: if request.auth != null && validContract(request.resource.data);
      allow read, update, delete: if isAdmin();
    }
  }
}
